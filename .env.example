# DeepSeek OpenAI-compatible chat API
DEEPSEEK_API_KEY=your_deepseek_api_key

# Tavily web search
TAVILY_API_KEY=your_tavily_api_key

# RAG embeddings use DashScope text-embedding-v4
DASHSCOPE_API_KEY=your_dashscope_api_key

# Streamlit 客户端连接的服务端地址（默认 http://127.0.0.1:8000）
# TS_AGENT_API_URL=http://127.0.0.1:8000

# 服务端 CORS 白名单（逗号分隔，默认仅允许本机 Streamlit 来源）
# TS_AGENT_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
